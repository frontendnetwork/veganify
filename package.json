{
	"name": "veganify",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"preinstall": "npx only-allow pnpm",
		"dev": "next dev --turbopack",
		"build": "next build",
		"start": "next start -p 1030",
		"stage": "next start -p 1031",
		"lint": "eslint .",
		"lint:fix": "eslint --fix .",
		"type-check": "tsc --noEmit",
		"test": "jest",
		"test:watch": "jest --watch",
		"test:coverage": "jest --coverage",
		"test:e2e": "playwright test"
	},
	"packageManager": "pnpm@10.19.0",
	"lint-staged": {
		"*.{js,jsx,ts,tsx}": [
			"eslint --fix"
		]
	},
	"dependencies": {
		"@ericblade/quagga2": "^1.12.1",
		"@frontendnetwork/veganify": "^2.0.17",
		"@types/node": "24.10.1",
		"@types/react-dom": "19.2.3",
		"next": "16.2.4",
		"next-intl": "^4.11.0",
		"react": "19.2.0",
		"react-dom": "19.2.0",
		"sass": "^1.99.0",
		"sharp": "^0.34.5",
		"typescript": "6.0.3"
	},
	"devDependencies": {
		"@playwright/test": "^1.59.1",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.1",
		"@types/jest": "^30.0.0",
		"@types/react": "19.2.14",
		"eslint": "9.39.4",
		"eslint-config-next": "16.2.4",
		"eslint-import-resolver-typescript": "^4.4.4",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-react-compiler": "19.1.0-rc.2",
		"jest": "^30.3.0",
		"jest-environment-jsdom": "^30.3.0",
		"ts-node": "^10.9.2",
		"typescript-eslint": "^8.58.2"
	},
	"volta": {
		"node": "20.0.0"
	},
	"pnpm": {
		"overrides": {
			"@types/react": "19.2.14",
			"@types/react-dom": "19.2.3",
			"eslint": "9.39.4",
			"react": "19.2.0",
			"react-dom": "19.2.0",
			"core-js": "^3.36.0",
			"glob": "^10.5.0",
			"sourcemap-codec": "^1.4.8",
			"@babel/helpers": ">=7.26.10",
			"@babel/runtime": ">=7.26.10",
			"diff": ">=4.0.4",
			"form-data": ">=2.5.4",
			"qs": ">=6.14.1",
			"flatted": ">=3.4.2",
			"eslint-plugin-import>minimatch": "^3.1.5",
			"eslint-plugin-jsx-a11y>minimatch": "^3.1.5",
			"eslint-plugin-react>minimatch": "^3.1.5",
			"glob>minimatch": "^9.0.9",
			"minimatch>brace-expansion": "^2.0.3",
			"tinyglobby>picomatch": "^4.0.4",
			"@istanbuljs/load-nyc-config>js-yaml": "^3.14.2"
		},
		"peerDependencyRules": {
			"allowedVersions": {
				"eslint": "9.39.4",
				"react": "19.2.0"
			},
			"ignoreMissing": [
				"@babel/core",
				"webpack",
				"react",
				"react-dom",
				"eslint"
			]
		}
	}
